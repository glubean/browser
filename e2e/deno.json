{
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "imports": {
    "@glubean/sdk": "jsr:@glubean/sdk@^0.12.0",
    "@glubean/sdk/plugin": "jsr:@glubean/sdk@^0.12.0/plugin"
  },
  "glubean": {
    "run": {
      "testDir": "./tests",
      "verbose": true,
      "pretty": true,
      "permissions": [
        "--allow-net",
        "--allow-read",
        "--allow-env",
        "--allow-run",
        "--allow-write"
      ]
    }
  }
}
